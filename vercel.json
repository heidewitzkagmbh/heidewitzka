{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/internal.js": {
      "includeFiles": "api/_cockpit/**"
    }
  },
  "rewrites": [
    {
      "source": "/intern",
      "destination": "/api/internal"
    },
    {
      "source": "/intern/:path*",
      "destination": "/api/internal"
    }
  ],
  "headers": [
    {
      "source": "/intern",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tim-vogt-erfahrungen",
      "destination": "/tim-vogt",
      "permanent": true
    },
    {
      "source": "/tim-vogt-erfahrungen.html",
      "destination": "/tim-vogt",
      "permanent": true
    }
  ]
}
